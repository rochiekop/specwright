# Copy to .env.local and fill in the providers you want. Restart `npm run dev` after editing.
# Only set the keys you use. Keys stay on the local server and are never sent to the browser.

# Default model for every step, as provider:model. Steps can be overridden on the Models page.
MODEL_DEFAULT=anthropic:claude-opus-5-5

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
MOONSHOT_API_KEY=
GROQ_API_KEY=

# Ollama runs locally and needs no key. Uncomment to enable it.
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Any other OpenAI-compatible endpoint (LM Studio, vLLM, a company gateway, ...)
# CUSTOM_BASE_URL=http://localhost:1234/v1
# CUSTOM_API_KEY=

# Every *_BASE_URL can be overridden, e.g. OPENAI_BASE_URL for an Azure/OpenAI proxy.

# SQLite file location (relative to the project folder)
# DATABASE_FILE=data/app.db
